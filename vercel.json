{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://orb-lite.ventas-6eb.workers.dev/api/$1"
    },
    {
      "source": "/_serverFn/(.*)",
      "destination": "https://orb-lite.ventas-6eb.workers.dev/_serverFn/$1"
    },
    {
      "source": "/_server/(.*)",
      "destination": "https://orb-lite.ventas-6eb.workers.dev/_server/$1"
    },
    {
      "source": "/wialon-lite-api/(.*)",
      "destination": "https://orb-lite.ventas-6eb.workers.dev/wialon-lite-api/$1"
    },
    {
      "source": "/wialon-full-api/(.*)",
      "destination": "https://orb-lite.ventas-6eb.workers.dev/wialon-full-api/$1"
    },
    {
      "source": "/wialon-api/(.*)",
      "destination": "https://orb-lite.ventas-6eb.workers.dev/wialon-api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
